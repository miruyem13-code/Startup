DATABASE_URL="file:./velocity.db"
# Supabase production: pooled PostgreSQL URL for DATABASE_URL and direct DB URL for DIRECT_URL.
# Keep these server-only. Never prefix secrets with VITE_. See docs/DEPLOYMENT.md.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
PORT=3001
APP_ORIGIN=http://localhost:5173
# Development allows localhost/127.0.0.1 on Vite ports 5173 and 5174; production only allows APP_ORIGIN.
DEMO_MODE=true
NODE_ENV=development
# Set unique passwords before seeding. Demo accounts are never created in production.
DEMO_USER_PASSWORD=<set-a-unique-local-demo-password>
DEMO_ADMIN_PASSWORD=<set-a-unique-local-admin-password>
DEMO_BUSINESS_PASSWORD=<set-a-unique-local-business-password>
