{
  "name": "velocity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "admin:provision": "node --env-file-if-exists=.env scripts/provision-admin.mjs",
    "admin:status": "node --env-file-if-exists=.env scripts/admin-status.mjs",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "db:postgres:prepare": "node scripts/postgres.mjs",
    "db:postgres:prepare:initial": "node scripts/postgres.mjs --refresh-initial",
    "db:postgres:generate": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:postgres:migrate": "node scripts/postgres-migrate.mjs",
    "demo:new": "node --env-file-if-exists=.env scripts/demo-new.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "lint": "eslint --config eslint.config.mjs apps packages scripts tests",
    "format": "prettier --write apps packages scripts tests docs *.json *.js *.ts *.mjs README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.1",
    "@turf/turf": "^7.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^14.1.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
