{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{.vercel-backend/**,node_modules/.prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__velocity_path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
